{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/commerce/**",
              "components/core/**",
              "components/partner/**",
              "ui_kits/bugsha/**",
              "ui_kits/cold-chain/**",
              "ui_kits/marketing/**",
              "ui_kits/partner/**",
              "ui_kits/ticket/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Readex Pro|Instrument Serif|Tajawal|Amiri|IBM Plex Sans|IBM Plex Sans Arabic|IBM Plex Mono|Archivo|JetBrains Mono|Alexandria))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Readex Pro, Instrument Serif, Tajawal, Amiri, IBM Plex Sans, IBM Plex Sans Arabic, IBM Plex Mono, Archivo, JetBrains Mono, Alexandria."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|uppercase|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, uppercase, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|fresh|time|urgent|deal|info|error)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'fresh' | 'time' | 'urgent' | 'deal' | 'info' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BagCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:partner|title|category|cover|priceNow|priceWas|currency|day|from|to|distanceKm|bagsLeft|leftFormat|rating|ratingCount|tags|minutesLeft|countdownFormat|saved|layout|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BagCard> doesn't accept that prop. Declared props: partner, title, category, cover, priceNow, priceWas, currency, day, from, to, distanceKm, bagsLeft, leftFormat, rating, ratingCount, tags, minutesLeft, countdownFormat, saved, layout, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BagCard'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:bakery|cafe|meals|grocery|other)$/]",
        "message": "<BagCard> category must be one of 'bakery' | 'cafe' | 'meals' | 'grocery' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BagCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:card|row|hero)$/]",
        "message": "<BagCard> layout must be one of 'card' | 'row' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|action|children|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, title, action, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|fresh|time|offline|error)$/]",
        "message": "<Banner> tone must be one of 'info' | 'fresh' | 'time' | 'offline' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|footer|children|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, title, onClose, footer, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|iconStart|iconEnd|loading|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, iconStart, iconEnd, loading, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|deal|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'deal' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padded|interactive|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padded, interactive, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|icon|count|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, icon, count, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountdownPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:minutesLeft|label|format|state|style|key|ref|className|style|children)$/]",
        "message": "<CountdownPill> doesn't accept that prop. Declared props: minutesLeft, label, format, state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountdownPill'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:browse|reserved)$/]",
        "message": "<CountdownPill> state must be one of 'browse' | 'reserved'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverPlate'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|category|height|label|radius|children|style|key|ref|className|style|children)$/]",
        "message": "<CoverPlate> doesn't accept that prop. Declared props: src, category, height, label, radius, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverPlate'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:bakery|cafe|meals|grocery|other)$/]",
        "message": "<CoverPlate> category must be one of 'bakery' | 'cafe' | 'meals' | 'grocery' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|body|confirmLabel|cancelLabel|tone|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, body, confirmLabel, cancelLabel, tone, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|danger)$/]",
        "message": "<Dialog> tone must be one of 'primary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, body, actionLabel, onAction, style."
