# ---------------------------------------------------------------------------
# Supabase edge function secrets (set with: supabase secrets set --env-file .env)
# ---------------------------------------------------------------------------

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into edge functions
# automatically — do NOT set them here.

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be on a domain verified in Resend, or delivery will fail.
WAITLIST_FROM_EMAIL="Bugsha <hello@bugsha.com>"

# Where new-signup notifications go. Leave blank to disable team notifications.
WAITLIST_ADMIN_EMAIL=admin@afterwave.org

# Optional: Reply-To on the subscriber confirmation.
WAITLIST_REPLY_TO=

# Used for the CTA link in emails and the "back to site" link on unsubscribe.
WAITLIST_SITE_URL=https://bugsha.com

# Comma-separated CORS allowlist. "*" allows any origin.
WAITLIST_ALLOWED_ORIGINS=https://bugsha.com,https://bugsha-launch-site-97ec9074-1e35-43.vercel.app

# ---------------------------------------------------------------------------
# Frontend (Vite) — safe to expose, it is a public endpoint
# ---------------------------------------------------------------------------
VITE_WAITLIST_ENDPOINT=https://qrmyhruvnqmjwxcnkocj.supabase.co/functions/v1/waitlist-signup
